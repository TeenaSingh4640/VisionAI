VISIONMATE_APP_NAME=VisionMate
VISIONMATE_ENV=development
VISIONMATE_HOST=0.0.0.0
VISIONMATE_PORT=8000
VISIONMATE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Perception
VISIONMATE_PERCEPTION_MODE=auto
VISIONMATE_YOLO_MODEL=yolov8n.pt
VISIONMATE_FRAME_MAX_BYTES=2500000
VISIONMATE_INFERENCE_MAX_SIDE=640

# Navigation: mock | osrm
VISIONMATE_ROUTING_PROVIDER=mock
VISIONMATE_OSRM_BASE_URL=https://router.project-osrm.org
VISIONMATE_ROUTING_TIMEOUT_S=8

# Optional SQLite session history (empty disables)
VISIONMATE_SQLITE_PATH=

# Rate limits
VISIONMATE_OBS_MIN_INTERVAL_MS=350
