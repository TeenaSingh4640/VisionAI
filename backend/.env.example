# Copy this file to .env for local overrides. Defaults run without credentials.
VISIONMATE_APP_NAME=VisionMate
VISIONMATE_ENV=development
VISIONMATE_HOST=127.0.0.1
VISIONMATE_PORT=8000
VISIONMATE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# auto tries YOLO first, then falls back to mock. Use mock for fully offline setup.
VISIONMATE_PERCEPTION_MODE=auto
VISIONMATE_YOLO_MODEL=yolo11s.pt
VISIONMATE_FRAME_MAX_BYTES=2500000
VISIONMATE_INFERENCE_MAX_SIDE=960
VISIONMATE_YOLO_CONFIDENCE=0.2
VISIONMATE_YOLO_MAX_DETECTIONS=100
VISIONMATE_OBS_MIN_INTERVAL_MS=350

# Mock routing is deterministic and simulated. OSRM is optional.
VISIONMATE_ROUTING_PROVIDER=mock
VISIONMATE_OSRM_BASE_URL=https://router.project-osrm.org
VISIONMATE_OSRM_PROFILE=foot
VISIONMATE_ROUTING_TIMEOUT_S=8
VISIONMATE_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
VISIONMATE_NOMINATIM_USER_AGENT=VisionMate/0.1.0 (destination search)
VISIONMATE_NOMINATIM_TIMEOUT_S=8
VISIONMATE_TURN_THRESHOLDS_M=500,200,50
