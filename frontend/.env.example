# Vite browser app: leave empty for local `npm run dev` (uses the /api and /ws proxy).
# Production static hosting MUST set this to the public backend, e.g. https://visionai-2723.onrender.com
VITE_API_URL=

# Expo (frontend/App.tsx or a physical device). Never ship localhost to a deployed client.
# Android emulator: http://10.0.2.2:8000
# iOS simulator: http://localhost:8000
EXPO_PUBLIC_API_URL=http://192.168.1.100:8000
